# GEMINI_API_KEY / GOOGLE_API_KEY: Required for Gemini & Google APIs.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# GOOGLE_CLIENT_ID: Required for Google OAuth / Google Sign-In verification.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
